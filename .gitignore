```gitignore
# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
env/
ENV/

# ==============================
# Local AI models
# ==============================
EmbeddinModel/

*.safetensors
*.onnx
*.pt
*.pth
*.bin

# ==============================
# IDEs and editors
# ==============================
.vscode/
.idea/
*.code-workspace

# ==============================
# OS-generated files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp

# ==============================
# Testing and coverage
# ==============================
.pytest_cache/
.coverage
htmlcov/

# ==============================
# Build artifacts
# ==============================
build/
dist/
*.egg-info/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example
```